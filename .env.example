# Environment Variables
# Copy this file to .env.local and fill in the values.
# All variables are optional; related widgets stay disabled when unset.

# NewsAPI key for the news widget (https://newsapi.org)
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Full NewsAPI query URL prefix (do not change unless API version updates)
NEWS_URL_QUERY=https://newsapi.org/v2/top-headlines?country=us&pageSize=10&apiKey

# Demo password for the Kali login screen (default: 1234)
# Only used in the frontend desktop simulation, not for real authentication.
NEXT_PUBLIC_DEMO_PASSWORD=1234
